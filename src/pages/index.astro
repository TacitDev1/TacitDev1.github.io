---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../../site.config.mjs';
import { href } from '../lib/links';

const projects = (await getCollection('projects', (p) => p.data.listed && !p.data.hidden)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base current="work">
  <h1 class="page-title">Projects</h1>
  <p class="intro">{site.intro}</p>

  <ul class="projects">
    {
      projects.map((p) => (
        <li>
          <a href={href(`/projects/${p.id}/`)}>
            {p.data.cover && (
              <img src={href(p.data.cover)} alt="" width="1600" height="1000" loading="lazy" />
            )}
            <h2>{p.data.title}</h2>
            <p>{p.data.summary}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
