---
import Base from '../layouts/Base.astro';
import site from '../../site.config.mjs';

const mode = site.contactEndpoint ? 'post' : site.email ? 'mail' : 'off';
---

<Base title="About" current="about">
  <h1 class="page-title">About</h1>

  <div class="prose">
    {site.about.map((para) => <p>{para}</p>)}
  </div>

  <section class="about-section" aria-labelledby="background">
    <h2 id="background">Background</h2>
    <div class="prose">
      {site.background.map((para) => <p>{para}</p>)}
      <ul>
        {site.credentials.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    {
      site.linkedin && (
        <p>
          <a href={site.linkedin} rel="me noopener">LinkedIn profile</a>
        </p>
      )
    }
  </section>

  <section class="about-section" aria-labelledby="contact">
    <h2 id="contact">Contact me</h2>
    <form
      class="contact"
      method="post"
      action={site.contactEndpoint || undefined}
      data-mode={mode}
      data-email={site.email || undefined}
      novalidate
    >
      <label>
        Name
        <input name="name" autocomplete="name" required maxlength="100" />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required maxlength="200" />
      </label>
      <label>
        Message
        <textarea name="message" rows="6" required maxlength="5000"></textarea>
      </label>
      <button type="submit">Send</button>
      <p class="form-status" role="status" aria-live="polite"></p>
      <p class="small">
        {
          mode === 'mail'
            ? 'Sending opens your email app with the message filled in. Nothing is stored on this site.'
            : 'Your message goes straight to my inbox and is used only to reply to you. Nothing is stored on this site.'
        }
      </p>
    </form>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form.contact');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const say = (text: string, bad = false) => {
      status.textContent = text;
      status.classList.toggle('bad', bad);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        const first = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(':invalid');
        say(
          first?.name === 'email' && first.value
            ? 'That email address doesn’t look right.'
            : 'Please fill in your name, email and message.',
          true,
        );
        first?.focus();
        return;
      }
      const data = new FormData(form);
      const mode = form.dataset.mode;

      if (mode === 'mail') {
        const subject = `Message from ${data.get('name')}`;
        const body = `${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        say('Your email app should open with the message ready to send.');
        return;
      }
      if (mode !== 'post') {
        say('The contact form is not connected yet.', true);
        return;
      }

      button.disabled = true;
      say('Sending…');
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('Thanks. Your message was sent, and I will reply by email.');
      } catch {
        say('The message could not be sent. Please try again in a minute.', true);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
